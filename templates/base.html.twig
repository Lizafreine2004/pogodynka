<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>Pogodynka</title>
        <!-- Dodajemy styl Bootstrap 5 -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        <style>
            body::before {
                content: "55741";
                position: fixed;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%) rotate(-30deg);
                font-size: 100px;
                color: rgba(0, 0, 0, 0.08);
                font-weight: bold;
                z-index: 9999;
                pointer-events: none;
            }
        </style>
    </head>
    <body>
        <!-- Pasek nawigacyjny -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">Pogodynka</a>
                <div class="navbar-nav">
                    <a class="nav-link" href="{{ path('app_location_index') }}">Lokalizacje</a>
                    <a class="nav-link" href="{{ path('app_measurement_index') }}">Pomiary</a>
                </div>
            </div>
        </nav>

        <!-- Główna zawartość strony zamknięta w kontenerze Bootstrapa -->
        <div class="container">
            {% block body %}{% endblock %}
        </div>
    </body>
</html>
