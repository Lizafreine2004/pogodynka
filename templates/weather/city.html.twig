{% extends 'base.html.twig' %}

{% block title %}Weather in {{ location.name }}{% endblock %}

{% block body %}
<main>
    <h1>Weather in {{ location.name }}</h1>

    <ul>
    {% for measurement in measurements %}
        <li>{{ measurement.date|date('d.m.Y') }}: {{ measurement.temperature }}°C</li>
    {% endfor %}
    </ul>
</main>
{% endblock %}
